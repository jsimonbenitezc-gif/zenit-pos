{
  "name": "zenit-pos",
  "version": "1.6.0",
  "description": "Sistema de registros y punto de venta digital.",
  "main": "pos/main.js",
  "author": "Zenit Software",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "revisar": "node scripts/revisar-huerfanas.js",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --publish never",
    "build-publish": "set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --publish always",
    "verificar": "npm run revisar && node scripts/smoke-cliente-por-telefono.js && node scripts/smoke-division-por-unidades.js && node scripts/smoke-kds-dispositivos.js && node scripts/smoke-rentabilidad.js && npm run probar:ui",
    "probar:ui": "node pruebas-ui/correr.js"
  },
  "build": {
    "appId": "com.zenit.pos",
    "productName": "Zenit POS",
    "icon": "graficos/zenit-icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "pos/**/*",
      "database/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/*.backup",
      "!**/*.bak"
    ],
    "win": {
      "target": "nsis",
      "sign": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "jsimonbenitezc-gif",
      "repo": "zenit-pos",
      "private": false,
      "releaseType": "release"
    }
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.9",
    "playwright-core": "^1.63.0"
  }
}
